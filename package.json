{
  "name": "greenlight",
  "version": "0.0.0",
  "private": true,
  "description": "Greenlight: verify deployed applications against approved requirements using Kane CLI.",
  "type": "module",
  "bin": {
    "greenlight": "bin/greenlight.js",
    "greenlight-stop-hook": "bin/greenlight-stop-hook.js",
    "greenlight-server": "bin/greenlight-server.js",
    "greenlight-admin": "bin/greenlight-admin.js",
    "greenlight-migrate-to-supabase": "bin/greenlight-migrate-to-supabase.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "server": "node bin/greenlight-server.js",
    "test:live": "GREENLIGHT_LIVE_SUPABASE=1 node --test test/server/supabase-anon-live.test.js test/server/supabase-live.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13"
  }
}
