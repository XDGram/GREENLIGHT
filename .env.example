# Greenlight server environment. Copy the NAMES, never commit values.
# Put SUPABASE_SERVICE_ROLE_KEY in the host's secret manager (or as a network secret injected by an
# egress proxy, in which case set a placeholder of the same form here). Never in Git or a frontend.

SUPABASE_URL=https://ncbrsrklofofdqdftwjw.supabase.co
# Secret key: Supabase dashboard -> project ceaser -> Project Settings -> API Keys -> Secret keys (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
GREENLIGHT_EVIDENCE_BUCKET=greenlight-evidence
# GREENLIGHT_WORK_DIR, GREENLIGHT_HOST and GREENLIGHT_PORT are set by the Dockerfile.
GREENLIGHT_PUBLIC_BASE_URL=https://greenlight.example.com

# Public key: NOT used by the server (the server refuses it). Only the live denial tests read it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_O3ev7dyTwadU-uAlsB-2Mw_3Y6SFuV7

# Optional: run on Vercel Functions + Vercel Sandbox instead of a persistent server (docs/HOSTING.md)
# GREENLIGHT_EXECUTION=sandbox
# GREENLIGHT_KANE_REMOTE=hyper
# GREENLIGHT_KANE_USERNAME=
# GREENLIGHT_KANE_ACCESS_KEY=

# Optional: approve tests in the browser with Sign in with Vercel (docs/APPROVAL.md)
# GREENLIGHT_VERCEL_APP_CLIENT_ID=
# GREENLIGHT_APPROVERS=[{"vercelSub":"<your Vercel subject>","account":"xdgram","user":"sadiqyusuf1775"}]
# GREENLIGHT_APPROVAL_SIGNING_KEY=        (secret, >= 32 chars; set in the host's secret store, never here)
# GREENLIGHT_BROWSER_APPROVAL_ACCOUNTS=xdgram
