{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{src,bin}/**"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/approve",
      "destination": "/api"
    },
    {
      "source": "/approve/:path*",
      "destination": "/api"
    }
  ]
}
